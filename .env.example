# Local machine settings for repo tooling.
# Copy this file to .env and fill in the path for your machine.

# Your WoT install directory. Required for deploy, cleanup, and cycle.
# The Dev Container's Docker Compose reads this to bind-mount it at /game;
# inside the container the tools see WOT_GAME_DIR=/game.
WOT_GAME_DIR=

# Your timezone, e.g. Europe/Warsaw. Optional. `zwm` prints the time each command
# finished; the container image runs on UTC, so leaving this empty means those
# timestamps read in UTC rather than your own clock.
TZ=
